# Скопируйте в .env и поправьте под себя
CQ_SITE_NAME=umedu
CQ_BASE_URL=https://example.org
CQ_SUBJECTS=python,russian
CQ_THEME=public
CQ_TIMEZONE=Europe/Moscow
CQ_COOKIE_SECURE=1
CQ_SIGNUP=0
CQ_MAX_STUDENTS=30
CQ_OPERATOR=
CQ_CONTACT=
CQ_SOURCE_URL=
CQ_TELEGRAM_TOKEN=
CQ_TELEGRAM_CHAT_ID=
CQ_PARENT_BOT=0
# Яндекс ID. Пусто (или нет одной из двух) — кнопки «Войти с Яндекс ID» нет.
# Redirect URI приложения: https://umedu.ru/auth/yandex/callback (из CQ_BASE_URL + /auth/yandex/callback).
# YANDEX_CLIENT_ID=
# YANDEX_CLIENT_SECRET=
